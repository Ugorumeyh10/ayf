# --- Database (Vercel Postgres / Neon) ---
# Vercel Storage → Postgres maps:
#   POSTGRES_PRISMA_URL          → DATABASE_URL  (pooled / PgBouncer, serverless)
#   POSTGRES_URL_NON_POOLING     → DIRECT_URL    (migrations only)
# Both must include sslmode=require. Do not put sslmode on DB_NAME.
# If the pooled URL lacks pgbouncer flags, append:
#   ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgres://user:password@host/db?sslmode=require"
DIRECT_URL="postgres://user:password@host/db?sslmode=require"

# --- Auth.js (admin login) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Required on Vercel (and local) so Auth.js trusts X-Forwarded-Host.
# Do NOT set AUTH_URL or NEXTAUTH_URL to localhost in the Vercel dashboard —
# preview URLs change every deploy and UntrustedHost will break login.
AUTH_TRUST_HOST="true"

# --- Rate limiting (Upstash Redis) for public forms ---
# Optional in local dev (requests are allowed through). Required before the
# site takes real traffic so Join / Contact cannot be flooded.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- File storage (executive photos, gallery, resources) ---
# Vercel Blob → Storage → Blob → Connect to project.
BLOB_READ_WRITE_TOKEN=""

# --- Local / first-office bootstrap (seed only; not used at runtime) ---
# Creates a SUPER_ADMIN if that email is not already in AdminUser.
ADMIN_BOOTSTRAP_NAME="IT Lead"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-strong-password"

# --- Member OTP delivery (Vercel production) ---
# The site runs on Vercel. Vercel does not send SMS or email itself.
# Existing members were imported with phone only (no emails), so SMS is required
# for the members' area. Termii is the usual Nigerian SMS API:
#   https://termii.com → API key, then a sender ID (or Termii's generic sender).
TERMII_API_KEY=""
TERMII_SENDER_ID=""
# Optional extra: email the same code when the member record has an email.
# Resend is the Vercel-native email API (https://resend.com). EMAIL_FROM must be
# a verified domain, e.g. AYF Lagos <signin@mail.yourdomain.org>.
RESEND_API_KEY=""
EMAIL_FROM=""
